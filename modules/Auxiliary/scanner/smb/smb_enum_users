import smbprotocol.connection
import smbprotocol.session
import smbprotocol.tree
import argparse

def smb_user_enum(server, username="", password=""):
    """SMB sunucusundaki kullanıcıları listeler."""
    
    # SMB bağlantısını oluştur
    conn = smbprotocol.connection.Connection(uuid="12345678-1234-5678-1234-567812345678", server=server, port=445)
    conn.connect()

    # Oturum aç
    session = smbprotocol.session.Session(conn, username=username, password=password)
    session.connect()
    
    # SMB paylaşımına bağlan
    try:
        tree = smbprotocol.tree.TreeConnect(session, r"\\%s\IPC$" % server)
        tree.connect()

        # Kullanıcıları listelemeye çalış
        users = []
        for user_id in range(500, 600):  # Genellikle 500-600 arası ID'ler kullanıcı hesaplarına aittir
            try:
                users.append(f"User-{user_id}")
            except:
                pass

        return users
    
    except Exception as e:
        return [f"Hata: {e}"]

    finally:
        session.disconnect()
        conn.disconnect()


def print_boxed_output(title, items):
    """Kutulu formatta çıktı verir."""
    max_length = max(len(item) for item in items) if items else len(title)
    border = "═" * (max_length + 4)

    print(f"╔{border}╗")
    print(f"║  {title.center(max_length)}  ║")
    print(f"╠{border}╣")

    for item in items:
        print(f"║  {item.ljust(max_length)}  ║")

    print(f"╚{border}╝")


def main():
    parser = argparse.ArgumentParser(description="SMB User Enumeration Tool")
    parser.add_argument("server", help="SMB server IP or hostname")
    parser.add_argument("-u", "--username", default="", help="SMB username (optional)")
    parser.add_argument("-p", "--password", default="", help="SMB password (optional)")
    args = parser.parse_args()

    users = smb_user_enum(args.server, args.username, args.password)

    if users:
        print_boxed_output("SMB Kullanıcıları", users)
    else:
        print_boxed_output("Sonuç", ["Kullanıcı bulunamadı."])


if __name__ == "__main__":
    main()