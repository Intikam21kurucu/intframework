#!/usr/bin/env python3
import os
import sys
import argparse
import logging
import subprocess
import shutil
from pathlib import Path

# --- GLOBAL VERBOSE FLAG ---
VERBOSE = False

# --- LOGGING CONFIGURATION ---
log_path = Path.home() / ".intconsole_log"
log_file = logging.FileHandler(log_path, encoding='utf-8')
null_out = open(os.devnull, 'w')
logging.basicConfig(
    level=logging.DEBUG,
    format='[%(asctime)s] [%(levelname)s] %(message)s',
    handlers=[
        log_file,
        logging.StreamHandler(sys.stderr if '--verbose' in sys.argv else null_out)
    ]
)

def log(msg):
    if VERBOSE:
        print(msg)

# --- MOVE SELF TO $PREFIX/bin ---

def move_self_to_bin(force_move=True):
    try:
        script_path = Path(__file__).resolve()
        prefix = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
        bin_path = Path(prefix) / "bin" / "intconsole"

        if script_path == bin_path:
            return  # Already in correct location

        # Copy then remove original to simulate mv (if mv fails)
        subprocess.run(["mv", str(script_path), str(bin_path)], check=True)
        bin_path.chmod(0o755)

        print(f"\n[✓] intconsole has been moved to {bin_path}")
        print(f"[!] Now run it with:\n\n    intconsole {' '.join(sys.argv[1:])}\n")
        sys.exit(0)
    except Exception as e:
        print(f"[!] Failed to move intconsole: {e}")
        sys.exit(1)


# --- REMOVE SELF ---
def uninstall_self():
    try:
        prefix = os.getenv("PREFIX")
        if not prefix:
            return
        path = Path(prefix) / "bin" / "intconsole"
        if path.exists():
            path.unlink()
            log(f"[✓] Removed: {path}")
        else:
            log("Already removed.")
    except Exception as e:
        logging.error(f"Uninstall failed: {e}")
        if VERBOSE:
            print(f"[!] Uninstall error: {e}")

# --- REPAIR SELF ---
def repair_install():
    uninstall_self()
    move_self_to_bin()
    log("[✓] Repair complete.")

# --- VALIDATE PATH ---
def get_intframework_path() -> Path:
    path = os.getenv("INTFRAMEWORK_PATH")
    if not path:
        sys.exit("ERROR: $INTFRAMEWORK_PATH environment variable is not set.")
    p = Path(path)
    if not p.is_dir():
        sys.exit(f"ERROR: Invalid INTFRAMEWORK_PATH: {p}")
    return p

# --- FETCH REMOTE DATA ---
def fetch_data_from_url(url: str) -> str | None:
    import requests
    try:
        r = requests.get(url, timeout=10)
        r.raise_for_status()
        return r.text
    except Exception as e:
        logging.error(f"Fetch error: {e}")
        return None

# --- RUN GIT COMMAND ---
def run_git_command(args: list[str], cwd: Path) -> bool:
    try:
        subprocess.run(args, cwd=cwd, check=True,
                       stdout=None if VERBOSE else subprocess.DEVNULL,
                       stderr=None if VERBOSE else subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError as e:
        logging.error(f"Git error: {args} | {e}")
        return False

# --- UPDATE REPO ---
def update_framework(path: Path, branch="intframeworkV4") -> bool:
    if not (path / ".git").exists():
        logging.error("Not a git repository.")
        return False
    return run_git_command(["git", "fetch", "--all"], path) and \
           run_git_command(["git", "reset", "--hard", f"origin/{branch}"], path)

# --- ENSURE LOCAL BRANCH EXISTS ---
def ensure_branch_exists(path: Path, branch="intframeworkV4", remote="intframeworkV4"):
    try:
        branches = subprocess.check_output(["git", "branch"], cwd=path, text=True)
        if branch not in branches:
            subprocess.run(["git", "checkout", "-b", branch, f"{remote}/{branch}"], cwd=path)
            log(f"[✓] Branch {branch} created.")
    except Exception as e:
        logging.error(f"Failed to create branch: {e}")

# --- COMMIT DIFFERENCE ---
def get_commit_difference(path: Path, branch="intframeworkV4") -> int:
    try:
        local = subprocess.check_output(["git", "rev-parse", branch], cwd=path, text=True).strip()
        remote = subprocess.check_output(["git", "rev-parse", f"origin/{branch}"], cwd=path, text=True).strip()
        count = subprocess.check_output(["git", "rev-list", "--count", f"{local}..{remote}"], cwd=path, text=True).strip()
        return int(count)
    except Exception as e:
        logging.error(f"Commit diff error: {e}")
        return 0

# --- CONDITIONAL AUTO-UPDATE ---
def conditional_update(path: Path, threshold=5, branch="intframeworkV4"):
    if run_git_command(["git", "fetch", "origin"], path):
        ensure_branch_exists(path, branch, "origin")
        if get_commit_difference(path, branch) >= threshold:
            update_framework(path, branch)

# --- EXECUTE COMMAND FILE (.int/.int4) ---
def ecff(file: str, path: Path):
    from scripts.handle_console import parse_and_run_commands
    p = Path(file)
    if not p.exists():
        logging.error("File not found.")
        return
    with p.open(encoding="utf-8") as f:
        for line in f:
            cmd = line.strip()
            if cmd:
                parse_and_run_commands(cmd)

# --- MAIN ---
def main():
    global VERBOSE

    pre_parser = argparse.ArgumentParser(add_help=False)
    pre_parser.add_argument("--verbose", action="store_true")
    pre_args, _ = pre_parser.parse_known_args()
    VERBOSE = pre_args.verbose
    logging.getLogger().setLevel(logging.DEBUG if VERBOSE else logging.ERROR)

    move_self_to_bin()  # Auto move to /bin

    path = get_intframework_path()

    parser = argparse.ArgumentParser(description="Intframework Console")
    parser.add_argument("-x", help="Execute single command")
    parser.add_argument("-i", "--int", help="Execute .int/.int4 command file")
    parser.add_argument("-q", action='store_true', help="Quiet mode")
    parser.add_argument("-v", "--version", action='store_true', help="Show version info")
    parser.add_argument("--update", action='store_true', help="Manual update")
    parser.add_argument("--check-updates-only", action='store_true', help="Show commit difference only")
    parser.add_argument("--repair", action='store_true', help="Reinstall and repair intconsole")
    parser.add_argument("--uninstall", action='store_true', help="Uninstall intconsole from bin")
    parser.add_argument("--verbose", action='store_true', help="Verbose output")
    args = parser.parse_args()

    if args.uninstall:
        uninstall_self()
        return

    if args.repair:
        repair_install()
        return

    if args.check_updates_only:
        diff = get_commit_difference(path, "intframeworkV4")
        log(f"New commits: {diff}")
        return

    if args.update:
        if update_framework(path, "intframeworkV4"):
            log("[✓] Update successful.")
        else:
            log("[!] Update failed.")
        return

    try:
        conditional_update(path)
    except Exception as e:
        logging.error(f"Auto-update error: {e}")

    if args.x:
        from scripts.handle_console import parse_and_run_commands
        parse_and_run_commands(args.x)
        return

    if args.int:
        ecff(args.int, path)
        return

    if args.q:
        q = path / "quited.py"
        if q.exists():
            subprocess.run(["python3", str(q)])
        else:
            logging.error("quited.py not found.")
        return

    if args.version:
        url = "https://raw.githubusercontent.com/intSpLoiT/intframework/refs/heads/intframeworkV4/version.md"
        info = fetch_data_from_url(url)
        print(info if info else "Version info not available.")
        return

    main_console = path / "intconsoleV4.py"
    if main_console.exists():
        subprocess.run(["python3", str(main_console)])
    else:
        logging.error("intconsoleV4.py not found.")

# --- ENTRYPOINT ---
if __name__ == "__main__":
    main()