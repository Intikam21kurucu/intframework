#!/usr/bin/env python3
import os
import argparse
import logging
import subprocess
from pathlib import Path

# --- LOGGING AYARI ---
log_path = Path.home() / ".intconsole_log"
logging.basicConfig(
    level=logging.ERROR,
    format='[%(asctime)s] [%(levelname)s] %(message)s',
    handlers=[logging.FileHandler(log_path, encoding='utf-8')]
)

# --- TEMEL FONKSİYONLAR ---
def get_intframework_path():
    path = os.getenv("INTFRAMEWORK_PATH")
    if not path or not Path(path).is_dir():
        logging.error("$INTFRAMEWORK_PATH environment variable is not set or invalid.")
        exit(1)
    return path

def fetch_data_from_url(url):
    import requests
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        return response.text
    except requests.RequestException as e:
        logging.error(f"Failed to fetch data: {e}")
        return None

def update_framework(intframework_path, branch="main"):
    repo_path = Path(intframework_path)
    if not (repo_path / ".git").exists():
        logging.error("Update failed: Not a git repository.")
        return False
    try:
        subprocess.run(["git", "fetch", "--all"], cwd=intframework_path, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["git", "reset", "--hard", f"origin/{branch}"], cwd=intframework_path, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        logging.info("Framework successfully updated.")
        return True
    except subprocess.CalledProcessError as e:
        logging.error(f"Update failed: {e}")
        return False

def get_commit_difference(repo_path, branch="main"):
    try:
        local = subprocess.check_output(["git", "rev-parse", branch], cwd=repo_path, text=True).strip()
        remote = subprocess.check_output(["git", "rev-parse", f"origin/{branch}"], cwd=repo_path, text=True).strip()
        count = subprocess.check_output(["git", "rev-list", "--count", f"{local}..{remote}"],
                                        cwd=repo_path, text=True).strip()
        return int(count)
    except Exception as e:
        logging.error(f"Failed to get commit difference: {e}")
        return 0

def conditional_update(intframework_path, threshold=5, branch="main"):
    try:
        subprocess.run(["git", "fetch", "origin"], cwd=intframework_path, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError as e:
        logging.error(f"Git fetch failed: {e}")
        return False

    diff_count = get_commit_difference(intframework_path, branch)
    if diff_count >= threshold:
        return update_framework(intframework_path, branch)
    return False

def ecff(file_path, intframework_path):
    from scripts.handle_console import parse_and_run_commands
    if not Path(file_path).exists():
        logging.error(f"File '{file_path}' not found.")
        return
    if not file_path.endswith((".int4", ".int")):
        logging.warning("Please use a .int4 or .int file.")
    try:
        with open(file_path, "r") as file:
            for line in file:
                cmd = line.strip()
                if cmd:
                    parse_and_run_commands(cmd)
    except Exception as e:
        logging.error(f"Error reading file: {e}")

# --- ANA FONKSİYON ---
def main():
    intframework_path = get_intframework_path()
    os.chdir(intframework_path)

    conditional_update(intframework_path, threshold=5, branch="main")

    url = "https://raw.githubusercontent.com/intSpLoiT/intframework/refs/heads/intframeworkV4/version.md"
    version_info = fetch_data_from_url(url)

    parser = argparse.ArgumentParser(description="Intframework Console Starter")
    parser.add_argument("-x", help="Execute command with intconsole")
    parser.add_argument("-i", "--int", help=".int file to read commands from")
    parser.add_argument("-q", action='store_true', help="Start intconsole in quiet mode")
    parser.add_argument("-v", "--version", action='store_true', help="Show version information")
    parser.add_argument("--update", action='store_true', help="Manually trigger update")
    args = parser.parse_args()

    if args.update:
        updated = update_framework(intframework_path)
        if not updated:
            logging.error("Manual update failed.")
        return

    if args.x:
        from scripts.handle_console import parse_and_run_commands
        parse_and_run_commands(args.x)
    elif args.int:
        ecff(args.int, intframework_path)
    elif args.q:
        quiet_script = Path(intframework_path) / "quited.py"
        if quiet_script.exists():
            subprocess.run(["python3", str(quiet_script)])
        else:
            logging.error("quited.py script not found.")
    elif args.version:
        if version_info:
            print(version_info)
        else:
            logging.info("Version info not available.")
    else:
        intconsole_script = Path(intframework_path) / "intconsoleV4.py"
        if intconsole_script.exists():
            subprocess.run(["python3", str(intconsole_script)])
        else:
            logging.error("intconsoleV4.py script not found.")

if __name__ == "__main__":
    main()