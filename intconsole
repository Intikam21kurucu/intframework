#!/usr/bin/env python3
import os
import sys
import argparse
import logging
import subprocess
import shutil
from pathlib import Path

# --- GLOBAL VERBOSE DEĞİŞKENİ ---
VERBOSE = False

# --- LOGGING AYARI ---
log_path = Path.home() / ".intconsole_log"
log_file = logging.FileHandler(log_path, encoding='utf-8')
null_out = open(os.devnull, 'w')
logging.basicConfig(
    level=logging.DEBUG,
    format='[%(asctime)s] [%(levelname)s] %(message)s',
    handlers=[
        log_file,
        logging.StreamHandler(sys.stderr if '--verbose' in sys.argv else null_out)
    ]
)

def log(msg):
    if VERBOSE:
        print(msg)

# --- KENDİNİ /bin DİZİNİNE TAŞIMA ---
def move_self_to_bin():
    try:
        script_path = Path(__file__).resolve()
        prefix = os.getenv("PREFIX")
        if not prefix:
            return
        bin_dir = Path(prefix) / "bin"
        target_path = bin_dir / "intconsole"
        if script_path == target_path:
            return  # Zaten doğru yerde
        if not bin_dir.exists():
            bin_dir.mkdir(parents=True)
        # mv komutu ile taşı
        subprocess.run(["mv", str(script_path), str(target_path)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        target_path.chmod(0o755)
        log(f"[✓] Taşındı: {target_path}")
        print(f"[!] Script taşındı. Şimdi şunu çalıştır:\n\n    intconsole { ' '.join(sys.argv[1:]) }\n")
        sys.exit(0)
    except Exception as e:
        logging.error(f"Taşıma başarısız: {e}")
        if VERBOSE:
            print(f"[!] mv hatası: {e}")
        sys.exit(1)

# --- KENDİNİ SİLME ---
def uninstall_self():
    try:
        prefix = os.getenv("PREFIX")
        if not prefix:
            return
        path = Path(prefix) / "bin" / "intconsole"
        if path.exists():
            path.unlink()
            log(f"[✓] Silindi: {path}")
        else:
            log("Zaten silinmiş.")
    except Exception as e:
        logging.error(f"Uninstall failed: {e}")
        if VERBOSE:
            print(f"[!] Uninstall error: {e}")

# --- ONARIM ---
def repair_install():
    uninstall_self()
    move_self_to_bin()
    log("[✓] Repair complete.")

# --- PATH DOĞRULAMA ---
def get_intframework_path() -> Path:
    path = os.getenv("INTFRAMEWORK_PATH")
    if not path:
        sys.exit("ERROR: $INTFRAMEWORK_PATH tanımlı değil.")
    p = Path(path)
    if not p.is_dir():
        sys.exit(f"ERROR: Geçersiz INTFRAMEWORK_PATH: {p}")
    return p

# --- VERİ ÇEKME ---
def fetch_data_from_url(url: str) -> str | None:
    import requests
    try:
        r = requests.get(url, timeout=10)
        r.raise_for_status()
        return r.text
    except Exception as e:
        logging.error(f"Fetch error: {e}")
        return None

# --- GİT KOMUTU ---
def run_git_command(args: list[str], cwd: Path) -> bool:
    try:
        subprocess.run(args, cwd=cwd, check=True,
                       stdout=None if VERBOSE else subprocess.DEVNULL,
                       stderr=None if VERBOSE else subprocess.DEVNULL)
        return True
    except subprocess.CalledProcessError as e:
        logging.error(f"Git error: {args} | {e}")
        return False

# --- UPDATE ---
def update_framework(path: Path, branch="intframeworkV4") -> bool:
    if not (path / ".git").exists():
        logging.error("Not a git repo.")
        return False
    return run_git_command(["git", "fetch", "--all"], path) and \
           run_git_command(["git", "reset", "--hard", f"origin/{branch}"], path)

# --- BRANCH CHECK ---
def ensure_branch_exists(path: Path, branch="intframeworkV4", remote="intframeworkV4"):
    try:
        branches = subprocess.check_output(["git", "branch"], cwd=path, text=True)
        if branch not in branches:
            subprocess.run(["git", "checkout", "-b", branch, f"{remote}/{branch}"], cwd=path)
            log(f"[✓] Branch {branch} oluşturuldu.")
    except Exception as e:
        logging.error(f"Branch oluşturulamadı: {e}")

# --- COMMIT FARKI ---
def get_commit_difference(path: Path, branch="intframeworkV4") -> int:
    try:
        local = subprocess.check_output(["git", "rev-parse", branch], cwd=path, text=True).strip()
        remote = subprocess.check_output(["git", "rev-parse", f"origin/{branch}"], cwd=path, text=True).strip()
        count = subprocess.check_output(["git", "rev-list", "--count", f"{local}..{remote}"], cwd=path, text=True).strip()
        return int(count)
    except Exception as e:
        logging.error(f"Commit diff error: {e}")
        return 0

def conditional_update(path: Path, threshold=5, branch="intframeworkV4"):
    if run_git_command(["git", "fetch", "origin"], path):
        ensure_branch_exists(path, branch, "origin")
        if get_commit_difference(path, branch) >= threshold:
            update_framework(path, branch)

def ecff(file: str, path: Path):
    from scripts.handle_console import parse_and_run_commands
    p = Path(file)
    if not p.exists():
        logging.error("File not found.")
        return
    with p.open(encoding="utf-8") as f:
        for line in f:
            cmd = line.strip()
            if cmd:
                parse_and_run_commands(cmd)

# --- ANA FONKSİYON ---
def main():
    global VERBOSE

    pre_parser = argparse.ArgumentParser(add_help=False)
    pre_parser.add_argument("--verbose", action="store_true")
    pre_args, _ = pre_parser.parse_known_args()
    VERBOSE = pre_args.verbose
    logging.getLogger().setLevel(logging.DEBUG if VERBOSE else logging.ERROR)

    move_self_to_bin()  # Otomatik mv taşıma

    path = get_intframework_path()

    parser = argparse.ArgumentParser(description="Intframework Console")
    parser.add_argument("-x", help="Tek komut çalıştır")
    parser.add_argument("-i", "--int", help=".int/.int4 dosyası çalıştır")
    parser.add_argument("-q", action='store_true', help="Sessiz mod")
    parser.add_argument("-v", "--version", action='store_true', help="Versiyon bilgisi")
    parser.add_argument("--update", action='store_true', help="Güncelleme yap")
    parser.add_argument("--check-updates-only", action='store_true', help="Sadece commit farkını göster")
    parser.add_argument("--repair", action='store_true', help="Onar ve yeniden kur")
    parser.add_argument("--uninstall", action='store_true', help="intconsole'u sil")
    parser.add_argument("--verbose", action='store_true', help="Detaylı çıktı")
    args = parser.parse_args()

    if args.uninstall:
        uninstall_self()
        return

    if args.repair:
        repair_install()
        return

    if args.check_updates_only:
        diff = get_commit_difference(path, "intframeworkV4")
        log(f"Yeni commit sayısı: {diff}")
        return

    if args.update:
        if update_framework(path, "intframeworkV4"):
            log("[✓] Güncelleme başarılı.")
        else:
            log("[!] Güncelleme başarısız.")
        return

    try:
        conditional_update(path)
    except Exception as e:
        logging.error(f"Otomatik güncelleme hatası: {e}")

    if args.x:
        from scripts.handle_console import parse_and_run_commands
        parse_and_run_commands(args.x)
        return

    if args.int:
        ecff(args.int, path)
        return

    if args.q:
        q = path / "quited.py"
        if q.exists():
            subprocess.run(["python3", str(q)])
        else:
            logging.error("quited.py bulunamadı.")
        return

    if args.version:
        url = "https://raw.githubusercontent.com/intSpLoiT/intframework/refs/heads/intframeworkV4/version.md"
        info = fetch_data_from_url(url)
        print(info if info else "Versiyon bilgisi alınamadı.")
        return

    main_console = path / "intconsoleV4.py"
    if main_console.exists():
        subprocess.run(["python3", str(main_console)])
    else:
        logging.error("intconsoleV4.py bulunamadı.")

# --- ÇALIŞTIRICI ---
if __name__ == "__main__":
    main()